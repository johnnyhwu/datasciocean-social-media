# 複製成 .env 並填入。.env 已在 .gitignore，絕對不要 commit，也不要把 token 貼進聊天視窗。
# 設定步驟見 .claude/skills/make-social-post/references/instagram-publish.md

# Instagram User access token（App Dashboard > Instagram > API setup with Instagram business login > Generate token；60 天長效）
IG_ACCESS_TOKEN=
# 你的 IG 專業帳號的 user id（不知道就留空，執行 ig_publish.py whoami 會自動補上）
IG_USER_ID=
# Graph API 版本（以官方文件範例的最新版為準）
IG_API_VERSION=v25.0
# token 取得或最近一次 refresh 的時間（ISO 格式，例如 2026-10-07T10:00:00+00:00）；whoami 成功後若沒填會自動補上現在時間
IG_TOKEN_REFRESHED_AT=
# 是否在輪播上標示 AI 生成（is_ai_generated）。專案規則 10：預設不加
IG_AI_GENERATED=false

# ---- Threads（另一組 token，跟上面的 IG token 不同）----
# 設定步驟見 .claude/skills/make-social-post/references/threads-publish.md
# Threads access token（App Dashboard > Use cases > Access the Threads API > Settings 的 Generate Access Token；要先加 Threads Tester 並在 Threads 接受邀請）
THREADS_ACCESS_TOKEN=
# 你的 Threads user id（不知道就留空，執行 threads_publish.py whoami 會自動補上）
THREADS_USER_ID=
# token 取得或最近一次 refresh 的時間（ISO 格式）；whoami 成功後若沒填會自動補上現在時間
THREADS_TOKEN_REFRESHED_AT=
# 只有在拿到的是「短效 token（1 小時）」時才需要：Threads 的 App Secret，用 exchange-token 換成 60 天長效 token。長效 token 用不到，可留空
THREADS_APP_SECRET=
# 選填：API 主機（graph.threads.net 或 graph.threads.com，官方兩種都有出現）與版本
THREADS_API_HOST=https://graph.threads.net
THREADS_API_VERSION=v1.0
