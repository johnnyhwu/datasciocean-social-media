# 複製成 .env 並填入。.env 已在 .gitignore，絕對不要 commit，也不要把 token 貼進聊天視窗。
# 設定步驟見 .claude/skills/make-social-post/references/instagram-publish.md

# Instagram User access token（App Dashboard > Instagram > API setup with Instagram business login > Generate token；60 天長效）
IG_ACCESS_TOKEN=
# 你的 IG 專業帳號的 user id（不知道就留空，執行 ig_publish.py whoami 會自動補上）
IG_USER_ID=
# Graph API 版本（以官方文件範例的最新版為準）
IG_API_VERSION=v25.0
# token 取得或最近一次 refresh 的時間（ISO 格式，例如 2026-10-07T10:00:00+00:00）；whoami 成功後若沒填會自動補上現在時間
IG_TOKEN_REFRESHED_AT=
# 是否在輪播上標示 AI 生成（is_ai_generated）。專案規則 10：預設不加
IG_AI_GENERATED=false
